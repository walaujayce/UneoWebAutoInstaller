<Page x:Class="UneoWebApplicationAutoInstaller.Views.Configuration"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UneoWebApplicationAutoInstaller.Views"
      xmlns:vm="clr-namespace:UneoWebApplicationAutoInstaller.ViewModels" d:DataContext="{d:DesignInstance Type=vm:ConfigurationViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Configuration">

    <Page.Resources>
        <Style x:Key="ButtonBorderStyle" TargetType="Border">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Width" Value="130"/>
            <Setter Property="BorderBrush" Value="#0078D3"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="White"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation
                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                To="#0078D3"
                Duration="0:0:0.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation
                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                To="White"
                Duration="0:0:0.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>                
            </Style.Triggers>
        </Style>

        <Style x:Key="Button2BorderStyle" TargetType="Border">
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect 
                Color="Gray" 
                BlurRadius="10" 
                ShadowDepth="1" 
                Direction="315" 
                Opacity="0.3"/>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="Tag" Value="MouseLeave">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect 
                                Color="Gray"
                                BlurRadius="10"
                                ShadowDepth="2"
                                Direction="315"
                                Opacity="0.3"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Tag" Value="LeftClickDown">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect 
                        Color="White"
                        BlurRadius="10"
                        ShadowDepth="2"
                        Direction="315"
                        Opacity="0.3"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Tag" Value="LeftClickUp">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect 
                        Color="Gray"
                        BlurRadius="10"
                        ShadowDepth="2"
                        Direction="315"
                        Opacity="0.3"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="ButtonTextBlockStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="arial"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
                
        <Style x:Key="CheckboxBorderStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="Transparent"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation
            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
            To="Transparent"
            Duration="0:0:0.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation
            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
            To="Transparent"
            Duration="0:0:0.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CheckButtonStyle" TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Style="{DynamicResource CheckboxBorderStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0">
                                <!-- Rectangle -->
                                <Grid>
                                    <Rectangle 
                                        x:Name="Rectangle"
                                        Margin="-5,0,0,0"
                                        Width="15"
                                        Height="15"
                                        Stroke="Black"
                                        StrokeThickness="0.5"
                                        Fill="White"
                                        VerticalAlignment="Center"/>
                                    <Border Height="20" Width="20" Margin="0,0,0,3" BorderBrush="Transparent" BorderThickness="1.5" Panel.ZIndex="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Image Source="{Binding CheckboxImage}"/>
                                    </Border>

                                </Grid>
                                <!-- Space between circle and text -->
                                <ContentPresenter Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        RecognizesAccessKey="True"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Optional: MouseOver effect -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rectangle" Property="StrokeThickness" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Copy Image Border-->
        <Style x:Key="CopyBorderStyle" TargetType="Border">
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Padding" Value="2,0,0,2"/>
            <Setter Property="Opacity" Value="0.3"/>
            <Setter Property="Cursor" Value="Hand"/>            
            <Style.Triggers>
                <Trigger Property="Tag" Value="MouseDown">
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
                <Trigger Property="Tag" Value="MouseLeave">
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style TargetType="ComboBox" x:Key="stlComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid Background="#F7FDF7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.7*"/>
                                <ColumnDefinition Width="0.3*" MaxWidth="30"/>
                            </Grid.ColumnDefinitions>
                            <TextBox  Grid.Column="0" IsReadOnly="True" Text="{TemplateBinding Text}"></TextBox>
                            <Border  Grid.Column="0" BorderThickness="1,1,0,1" BorderBrush="#81D779" CornerRadius="1,0,0,1">
                            </Border>
                            
                            <Border Grid.Column="1" BorderThickness="0,1,1,1" BorderBrush="#81D779" CornerRadius="0,1,1,0">
                            </Border>
                           
                            <Popup IsOpen="True" Placement="Bottom" x:Name="Popup" Focusable="False" AllowsTransparency="True" PopupAnimation="Slide">
                                <Border CornerRadius="1" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}" x:Name="DropDown" SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="0" Opacity="0.5"/>
                                    </Border.Effect>
                                    <ScrollViewer Margin="4,6,4,6" MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                        <!-- StackPanel 用于显示子级，方法是将 IsItemsHost 设置为 True -->
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Background="White"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Check box template -->
        <DataTemplate x:Key="CheckBoxTemplate">
            <CheckBox x:Name="InstallCheckbox" Style="{DynamicResource CheckButtonStyle}" IsChecked="{Binding IsChecked}"/>
        </DataTemplate>
        
        <!-- Combo box template -->
        <DataTemplate x:Key="ComboBoxTemplate">
            <ComboBox Name="SecurityComboBox" 
                      VerticalContentAlignment="Center"
                        Height="Auto"
                        Width="Auto"
                        Opacity="1" 
                        BorderThickness="1"
                      Cursor="Hand"
                      SelectedValuePath="Tag" 
                      SelectedValue="{Binding DictionaryValue, Mode=TwoWay}">
                <ComboBoxItem Content="None" Tag="0"/>
                <ComboBoxItem Content="WPA" Tag="1"/>
                <ComboBoxItem Content="WPA2" Tag="2"/>
            </ComboBox>
        </DataTemplate>
        
        <!-- Input box template -->        
        <DataTemplate x:Key="InputBoxTemplate">
            <Border Grid.Column="1" Background="White" BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" MouseLeftButtonUp="SelectedInputBox_Clicked">
                <TextBox Text="{Binding DictionaryValue}" Padding="5,0" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" TextChanged="InputBox_TextChanged"/>
            </Border>
        </DataTemplate>

        <vm:InputTypeTemplateSelector x:Key="InputTypeTemplateSelector"
            CheckBoxTemplate="{StaticResource CheckBoxTemplate}"
            ComboBoxTemplate="{StaticResource ComboBoxTemplate}"
            InputBoxTemplate="{StaticResource InputBoxTemplate}"
        />
    </Page.Resources>
    
    <Grid>
         <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4.5*"/>
            <ColumnDefinition Width="5.5*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="0" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderBrush="Black" BorderThickness="0.5" CornerRadius="15" Margin="50,0" Padding="10,10,10,5">
                <StackPanel Orientation="Vertical" VerticalAlignment="Top">
                    <Grid x:Name="Wifi_And_Password">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SSID" FontWeight="Bold" FontFamily="roboto"/>
                        <Grid Grid.Column="1" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="9*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Password" FontWeight="Bold" FontFamily="roboto"/>
                            <Border Grid.Column="1" Cursor="Hand" MouseLeftButtonUp="RefreshWifiAndIpv4List_Clicked" Padding="1">
                                <Image Source="/Views/Assets/Icon_Refresh.png" Loaded="RefreshIcon_Loaded">
                                    <Image.RenderTransform>
                                        <RotateTransform x:Name="RefreshRotateTransform" Angle="0" />
                                    </Image.RenderTransform>
                                </Image>
                            </Border>
                        </Grid>
                    </Grid>
                    <Separator BorderThickness="1" BorderBrush="Black" Margin="0,5" Opacity="0.5"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock x:Name="WifiNameTextBlock" Text="{Binding ConnectedWifiName}" FontFamily="roboto" VerticalAlignment="Center"/>
                            <Border ToolTip="Copy content" Height="{Binding ActualHeight, ElementName=WifiNameTextBlock}" Style="{DynamicResource CopyBorderStyle}" MouseLeftButtonUp="CopyWifiName_Clicked" MouseLeave="CursorStatus_MouseLeave">
                                <Image Source="/Views/Assets/Icon_Copy.png" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock x:Name="WifiPasswordTextBlock" Text="{Binding ConnectedWifiPassword}" FontFamily="roboto" VerticalAlignment="Center"/>
                            <Border ToolTip="Copy content" Height="{Binding ActualHeight, ElementName=WifiPasswordTextBlock}" Style="{DynamicResource CopyBorderStyle}" MouseLeftButtonUp="CopyWifiPassword_Clicked" MouseLeave="CursorStatus_MouseLeave">
                                <Image Source="/Views/Assets/Icon_Copy.png" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="InterfaceName_And_Ipv4Address">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Interface Name" FontWeight="Bold" FontFamily="roboto"/>
                        <TextBlock Grid.Column="1" Text="IPv4 Address" FontWeight="Bold" FontFamily="roboto"/>
                    </Grid>
                    <Separator BorderThickness="1" BorderBrush="Black" Margin="0,5" Opacity="0.5"/>
                    <ItemsControl ItemsSource="{Binding IpAddressList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DictionaryKey}" FontFamily="roboto"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock x:Name="IpAddressTextBlock" Text="{Binding DictionaryValue}" FontFamily="roboto" VerticalAlignment="Center"/>
                                        <Border ToolTip="Copy content" Height="{Binding ActualHeight, ElementName=IpAddressTextBlock}" Style="{DynamicResource CopyBorderStyle}" MouseLeftButtonUp="CopyIPv4Address_Clicked" MouseLeave="CursorStatus_MouseLeave">
                                            <Image Source="/Views/Assets/Icon_Copy.png" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border x:Name="StatusMessage" Grid.Row="1" Background="White" BorderBrush="Black" BorderThickness="0.5" CornerRadius="15" Margin="50,20,50,0" Padding="10">
                <StackPanel Orientation="Vertical">
                    <Grid x:Name="TitleBar">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="TitleBarTextBlock" Text="Status message" FontWeight="Bold" FontFamily="roboto" VerticalAlignment="Center"/>
                        <Border Grid.Column="2" BorderBrush="Black" BorderThickness="0.2" CornerRadius="5" Margin="0" Padding="3" VerticalAlignment="Center" Opacity="{Binding ConnectStatusOpacity}">
                            <StackPanel Orientation="Horizontal">
                                <Border Height="{Binding ActualHeight, ElementName=TitleBarTextBlock}" Padding="3">
                                    <Image Source="{Binding ConnectStatusImage}"/>                                    
                                </Border>
                                <TextBlock x:Name="StatusTextBlock" Text="{Binding ConnectStatusText}" VerticalAlignment="Center" FontFamily="times new roman"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Separator BorderThickness="1" BorderBrush="Black" Margin="0,5" Opacity="0.5"/>
                    <TextBlock Text="{Binding StatusMessageText}" Margin="0,5"/>                          
                </StackPanel>
            </Border>
            <Grid Grid.Row="2" Margin="0,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Center">
                    <!-- Connect button -->
                    <Border Style="{DynamicResource Button2BorderStyle}" ToolTip="Connect/Read" MouseLeftButtonUp="ConnectButton_Clicked" MouseLeftButtonDown="LeftMouseButtonDown_Clicked" MouseLeave="MouseLeaveCaptured">
                        <Image Source="/Views/Assets/Icon_USB.png"/>
                    </Border>
                    <!-- Write button -->
                    <Border Style="{DynamicResource Button2BorderStyle}" ToolTip="Write" MouseLeftButtonUp="WriteButton_Clicked" MouseLeftButtonDown="LeftMouseButtonDown_Clicked" MouseLeave="MouseLeaveCaptured">
                        <Image Source="/Views/Assets/Icon_Write.png"/>
                    </Border>
                    <!-- Save template -->
                    <Border Style="{DynamicResource Button2BorderStyle}" ToolTip="Save template" MouseLeftButtonUp="SaveButton_Clicked" MouseLeftButtonDown="LeftMouseButtonDown_Clicked" MouseLeave="MouseLeaveCaptured">
                        <Grid>
                            <Border ToolTip="{Binding SaveTemplateText}" Visibility="{Binding SaveTemplateVisibility}" BorderBrush="DarkGray" Background="White" BorderThickness="1" Margin="28,-22,-20,30" CornerRadius="10" Panel.ZIndex="10" Cursor="Arrow">
                                <Label Foreground="LimeGreen" FontSize="14" FontFamily="times new roman" FontWeight="Bold" FontStyle="Italic" Content="i" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0"/>
                            </Border>
                            <Image Source="{Binding SaveTemplateImage}"/>
                        </Grid>
                    </Border>
                    <!-- Write with template -->
                    <Border Style="{DynamicResource Button2BorderStyle}" ToolTip="Write template" IsEnabled="{Binding IsWriteTemplateBtnEnabled}" MouseLeftButtonUp="WriteWithTemplateButton_Clicked" MouseLeftButtonDown="LeftMouseButtonDown_Clicked" MouseLeave="MouseLeaveCaptured">
                        <Image Source="/Views/Assets/Icon_WriteTemplate.png" Opacity="{Binding WriteTemplateImageOpacity}"/>
                    </Border>
                </StackPanel>
            </Grid>
            <!-- TEMP message -->
            <!--
            <Border Grid.Row="3" BorderBrush="Black" BorderThickness="1" Margin="50,10" Padding="10">
                <Grid VerticalAlignment="Top">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{Binding SaveTemplateText}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            -->
            <!-- Control button -->
            <Grid Grid.Row="3" Margin="15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Border Style="{DynamicResource BackButtonStyle}" MouseLeftButtonUp="BackToPrevious_Configuration_Clicked">
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Border.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BackLabel"
                 Storyboard.TargetProperty="(Label.Foreground).(SolidColorBrush.Color)"
                 To="Black" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Border.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BackLabel"
                 Storyboard.TargetProperty="(Label.Foreground).(SolidColorBrush.Color)"
                 To="Gray" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <Label x:Name="BackLabel"
                FontSize="18"
                Content="Back"
                Foreground="Gray"
                VerticalContentAlignment="Center"
                HorizontalContentAlignment="Center"/>
                    </Border>
                </Grid>
                <Grid Grid.Column="2">

                </Grid>
            </Grid>
        </Grid>
        <!-- Main Content -->
        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" VerticalAlignment="Top"  HorizontalAlignment="Left">
                <Border Width="400" BorderBrush="Black" BorderThickness="0.3" Background="Beige" CornerRadius="20" Padding="15,10">
                    <ItemsControl ItemsSource="{Binding WifiSettingsList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical">
                                    <Border Height="20">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding SettingTitle}" FontWeight="Bold" FontFamily="tahoma"/>
                                    </Border>
                                    <Separator BorderThickness="1" BorderBrush="Black" Opacity="0.5" Margin="0,5,0,5"/>
                                    <ItemsControl ItemsSource="{Binding SettingList}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="30" Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding DictionaryKey}" VerticalAlignment="Center" FontFamily="arial"/>
                                                    <ContentControl Grid.Column="1" 
                                                    Content="{Binding}" 
                                                    ContentTemplateSelector="{StaticResource InputTypeTemplateSelector}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>
            <Grid Grid.Column="1" VerticalAlignment="Bottom" Margin="5,0">
                <StackPanel Orientation="Horizontal" Height="18" Cursor="Hand" MouseLeftButtonUp="ProceedToHelpCenter_Clicked">
                    <Border Padding="1.5">                          
                        <Image Source="/Views/Assets/Icon_Help.png"/>
                    </Border>
                    <Border Margin="2,0,0,0" BorderThickness="0,0,0,1" BorderBrush="Blue">
                        <TextBlock Text="Help Center" VerticalAlignment="Center" Foreground="Blue" FontFamily="times new roman" />
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>       
        
        <!-- template-->
        <!-- Connection Mode Toggle Button -->
