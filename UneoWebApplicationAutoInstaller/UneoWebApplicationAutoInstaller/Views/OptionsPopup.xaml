<UserControl x:Class="UneoWebApplicationAutoInstaller.Views.OptionsPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UneoWebApplicationAutoInstaller.Views"
             mc:Ignorable="d"              
             >
    <UserControl.Resources>
        <!-- ListBox Item Style -->
        <Style x:Key="ListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="true"> 
                            <ContentPresenter HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Margin="4,2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE0E0E0"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF888888"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFD0D0D0"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF555555"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Popup x:Name="OptionPopupList"
                AllowsTransparency="True"
                Placement="MousePoint" 
                IsOpen="False"
                StaysOpen="False" 
                PopupAnimation="Fade"
                >
        <Border Width="250" Height="Auto" Background="White"  BorderBrush="Black" BorderThickness="0.5" CornerRadius="5" Padding="2.5,0">
            <ListBox x:Name="OptionsListBox" Background="Transparent" BorderThickness="0" SelectionChanged="OptionListBoxItem_SelectedChanged" ItemsSource="{Binding OptionsList}">
                <ListBoxItem Style="{DynamicResource ListBoxItemStyle}">192.9.120.154 (Wi-Fi)</ListBoxItem>
                <ListBoxItem Style="{DynamicResource ListBoxItemStyle}">192.168.120.154 (Ethernet)</ListBoxItem>
                <ListBoxItem Style="{DynamicResource ListBoxItemStyle}">123.0.1.1 (Docker Bridge Gateway)</ListBoxItem>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Style="{DynamicResource ListBoxItemStyle}" Text="{Binding}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Popup>
</UserControl>
