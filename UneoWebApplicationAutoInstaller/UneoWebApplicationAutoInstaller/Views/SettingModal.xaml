<Window x:Class="UneoWebApplicationAutoInstaller.Views.SettingModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UneoWebApplicationAutoInstaller.Views"
        xmlns:vm="clr-namespace:UneoWebApplicationAutoInstaller.ViewModels" d:DataContext="{d:DesignInstance Type=vm:SettingViewModel}" 
        mc:Ignorable="d"
        WindowStyle="None"
        ResizeMode="NoResize"        
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        Height="500" Width="450">

    <Window.Resources>
        <Style x:Key="TextBlock_Name" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="TextBox_Value" TargetType="TextBox">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0,0,0"/>            
        </Style>
        <Style x:Key="Border_Short" TargetType="Border">
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
        <Style x:Key="Border_Image" TargetType="Border">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="17.5"/>
        </Style>
        <!-- Single Input Template -->
        <DataTemplate x:Key="SingleInputTemplate">
            <StackPanel Orientation="Vertical" Margin="0,0,0,15">
                <TextBlock Text="{Binding SettingName}" Style="{DynamicResource TextBlock_Name}"/>
                <Border Height="35" Style="{DynamicResource Border_Short}">
                    <TextBox Text="{Binding SettingValue}" Style="{DynamicResource TextBox_Value}"/>
                </Border>
            </StackPanel>
        </DataTemplate>
        <!-- Multiple Input Template -->
        <DataTemplate x:Key="MultipleInputTemplate">
            <StackPanel Orientation="Vertical" Margin="0,0,0,0">
                <TextBlock Text="{Binding SettingName}" Style="{DynamicResource TextBlock_Name}"/>
                <ItemsControl ItemsSource="{Binding InputList}">                    
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="35" Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>    
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{DynamicResource Border_Short}">
                                    <TextBox Text="{Binding DictionaryValue}" Style="{DynamicResource TextBox_Value}"/>
                                </Border>
                                <Border Grid.Column="1" Style="{DynamicResource Border_Image}" MouseLeftButtonUp="AddInputBtn_Clicked">
                                    <Image Width="Auto" Source="/Views/Assets/Icon_Add_FFD3D3D3.png" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>                
            </StackPanel>
        </DataTemplate>
        <!-- Multiple Key Value Template -->
        <DataTemplate x:Key="MultipleKeyValueTemplate">
            <StackPanel Orientation="Vertical" Margin="0,0,0,0">
                <TextBlock Text="{Binding SettingName}" Style="{DynamicResource TextBlock_Name}"/>
                <ItemsControl ItemsSource="{Binding KeyValueItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="35" Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{DynamicResource Border_Short}">
                                    <TextBox Text="{Binding DictionaryKey}" Style="{DynamicResource TextBox_Value}"/>
                                </Border>
                                <Border Grid.Column="2" Style="{DynamicResource Border_Short}">
                                    <TextBox Text="{Binding DictionaryValue}" Style="{DynamicResource TextBox_Value}"/>
                                </Border>
                                <Border Grid.Column="3" Style="{DynamicResource Border_Image}" Cursor="Hand" MouseLeftButtonUp="AddKeyValuePairBtn_Clicked">
                                    <Image Width="Auto" Source="{Binding AddBtnImageSource}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
            </StackPanel>
        </DataTemplate>

        <!-- The Selector -->
        <vm:SettingTemplateSelector x:Key="SettingTemplateSelector"
                       SingleInputTemplate="{StaticResource SingleInputTemplate}"
                       MultipleInputTemplate="{StaticResource MultipleInputTemplate}"
                       MultipleKeyValueTemplate="{StaticResource MultipleKeyValueTemplate}"/>

    </Window.Resources>
    
    <Grid>
        <Border Padding="10" BorderBrush="Black" BorderThickness="0.1" CornerRadius="5" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <!--Title-->
                    <RowDefinition Height="Auto"/>
                    <!--progress bar-->
                    <RowDefinition Height="Auto"/>
                    <!--main content-->
                    <RowDefinition Height="*"/>
                    <!--control button-->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!--Title-->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontFamily="Verdana" FontWeight="Bold" Text="{Binding SettingTitle}" FontSize="14" Padding="0" Margin="0,5"/>
                    <Border Grid.Column="1" Style="{DynamicResource Border_Image}">
                        <Image Cursor="Hand" MouseLeftButtonDown="CloseBtn_Clicked" Source="/Views/Assets/Icon_Close_FFD3D3D3.png"/>
                    </Border>
                </Grid>
                <!--Progress Bar-->
                <ItemsControl ItemsSource="{Binding ProgressItems}" Grid.Row="1" Margin="0,5">  
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Height="3" Background="{Binding ProgressBarColor}" CornerRadius="1.5"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--Setting List-->
                <Grid Grid.Row="2" Margin="0,5">
                    <Border BorderBrush="Black" BorderThickness="0" CornerRadius="5">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <ItemsControl ItemsSource="{Binding SettingList}" ItemTemplateSelector="{StaticResource SettingTemplateSelector}" VerticalAlignment="Top">
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
                <!--Control Button-->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Border Width="100" Height="40" CornerRadius="8" Background="LightGray" Cursor="Hand" MouseLeftButtonUp="BackToPrevious_SettingModal_Clicked">
                            <Label FontSize="18" Content="Back" Foreground="Gray" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                        </Border>
                    </Grid>
                    <Grid Grid.Column="2">
                        <Border  Width="100" Height="40" CornerRadius="8" Background="#0078D3" Cursor="Hand" MouseLeftButtonUp="ProceedToNextStage_SettingModal_Clicked">
                            <Label FontSize="18" Content="Next" Foreground="White" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
