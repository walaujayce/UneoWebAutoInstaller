<Window x:Class="UneoWebApplicationAutoInstaller.Views.SettingModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UneoWebApplicationAutoInstaller.Views"
        xmlns:vm="clr-namespace:UneoWebApplicationAutoInstaller.ViewModels" d:DataContext="{d:DesignInstance Type=vm:SettingViewModel}" 
        mc:Ignorable="d"
        WindowStyle="None"
        ResizeMode="NoResize"        
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        Height="520" Width="450">

    <Window.Resources>
        <Style x:Key="TextBlock_Name" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="TextBox_Value" TargetType="TextBox">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0,0,0"/>            
        </Style>
        <Style x:Key="Border_Short" TargetType="Border">
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
        <Style x:Key="Border_Image" TargetType="Border">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="17.5"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="Transparent"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation
                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                To="#E9E9E9"
                                Duration="0:0:0.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>    
                                <ColorAnimation
                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                To="Transparent"
                                Duration="0:0:0.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Border_Image_CloseBtn" TargetType="Border">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="17.5"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="Transparent"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation
                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                            To="#ff4747"
                            Duration="0:0:0.3"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation
                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                            To="Transparent"
                            Duration="0:0:0.3"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="BackBtn" TargetType="Border">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="BorderBrush" Value="#0078D3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="Transparent"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation
                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                    To="#eaeaea"
                    Duration="0:0:0.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation
                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                    To="Transparent"
                    Duration="0:0:0.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NextBtn" TargetType="Border">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="#0078D3"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation
                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                    To="#0C49C2"
                                    Duration="0:0:0.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation
                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                    To="#0078D3"
                                    Duration="0:0:0.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            
                <DataTrigger Binding="{Binding NextBtnLabel}" Value="Run">
                    <Setter Property="Background" Value="#00E500"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding NextBtnLabel}" Value="Run"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation
                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                    To="#02cc02"
                                    Duration="0:0:0.1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation
                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                    To="#00E500"
                                    Duration="0:0:0.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Single Input Template -->
        <DataTemplate x:Key="SingleInputTemplate">
            <Grid MouseLeftButtonDown="SetCurrentSettingSelected_Clicked">
                <StackPanel Orientation="Vertical" Margin="0,0,0,15">
                    <TextBlock Text="{Binding SettingName}" Style="{DynamicResource TextBlock_Name}"/>
                    <Border Height="35" Style="{DynamicResource Border_Short}">
                        <TextBox Text="{Binding SettingValue}" Style="{DynamicResource TextBox_Value}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <!-- Multiple Input Template -->
        <DataTemplate x:Key="MultipleInputTemplate">
            <Grid MouseLeftButtonDown="SetCurrentSettingSelected_Clicked">
                <StackPanel Orientation="Vertical" Margin="0,0,0,0">
                    <TextBlock Text="{Binding SettingName}" Style="{DynamicResource TextBlock_Name}"/>
                    <ItemsControl ItemsSource="{Binding InputList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="35" Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{DynamicResource Border_Short}">
                                        <TextBox Text="{Binding DictionaryValue}" Style="{DynamicResource TextBox_Value}"/>
                                    </Border>
                                    <Border Grid.Column="1" Style="{DynamicResource Border_Image}" Cursor="Hand" MouseLeftButtonUp="AddInputBtn_Clicked">
                                        <Image Width="Auto" Source="{Binding AddBtnImageSource}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <!-- Multiple Key Value Template -->
        <DataTemplate x:Key="MultipleKeyValueTemplate">
            <Grid MouseLeftButtonDown="SetCurrentSettingSelected_Clicked">
                <StackPanel Orientation="Vertical" Margin="0,0,0,0">
                    <TextBlock Text="{Binding SettingName}" Style="{DynamicResource TextBlock_Name}"/>
                    <ItemsControl ItemsSource="{Binding KeyValueItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="35" Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{DynamicResource Border_Short}">
                                        <TextBox Text="{Binding DictionaryKey}" Style="{DynamicResource TextBox_Value}"/>
                                    </Border>
                                    <Border Grid.Column="2" Style="{DynamicResource Border_Short}">
                                        <TextBox Text="{Binding DictionaryValue}" Style="{DynamicResource TextBox_Value}"/>
                                    </Border>
                                    <Border Grid.Column="3" Style="{DynamicResource Border_Image}" Cursor="Hand" MouseLeftButtonUp="AddKeyValuePairBtn_Clicked">
                                        <Image Width="Auto" Source="{Binding AddBtnImageSource}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- The Selector -->
        <vm:SettingTemplateSelector x:Key="SettingTemplateSelector"
                       SingleInputTemplate="{StaticResource SingleInputTemplate}"
                       MultipleInputTemplate="{StaticResource MultipleInputTemplate}"
                       MultipleKeyValueTemplate="{StaticResource MultipleKeyValueTemplate}"/>

    </Window.Resources>
    
    <Grid>
        <Border Padding="10" BorderBrush="Black" BorderThickness="0.1" CornerRadius="5" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <!--Title-->
                    <RowDefinition Height="Auto"/>
                    <!--progress bar-->
                    <RowDefinition Height="Auto"/>
                    <!--main content-->
                    <RowDefinition Height="*"/>
                    <!--control button-->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!--Title-->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="35"/>
                    <TextBlock Grid.Column="1" FontFamily="Roboto" FontWeight="Bold" Text="{Binding SettingTitle}" FontSize="16" Padding="0" Margin="0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <Border Grid.Column="2" Style="{DynamicResource Border_Image_CloseBtn}" Cursor="Hand" MouseLeftButtonUp="CloseBtn_Clicked">
                        <Image Source="/Views/Assets/Icon_Close_FFD3D3D3.png"/>
                    </Border>
                </Grid>
                <!--Progress Bar-->
                <ItemsControl ItemsSource="{Binding ProgressItems}" Grid.Row="1" Margin="0,5">  
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Height="3" Background="{Binding ProgressBarColor}" CornerRadius="1.5" Margin="1,0"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--Setting List-->
                <Grid Grid.Row="2" Margin="0,5">
                    <Border BorderBrush="Black" BorderThickness="0" CornerRadius="5">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <ItemsControl ItemsSource="{Binding SettingList}" ItemTemplateSelector="{StaticResource SettingTemplateSelector}" VerticalAlignment="Top">
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
                <!--Control Button-->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Border Style="{DynamicResource BackBtn}" MouseLeftButtonUp="BackToPrevious_SettingModal_Clicked">
                            <Label FontSize="14" Content="{Binding BackBtnLabel}" FontFamily="Tahoma" Foreground="#0078D3" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                        </Border>
                    </Grid>
                    <Grid Grid.Column="2">
                        <Border Style="{DynamicResource NextBtn}" MouseLeftButtonUp="ProceedToNextStage_SettingModal_Clicked">
                            <Label FontSize="14" Content="{Binding NextBtnLabel}" FontFamily="Tahoma" Foreground="{Binding NextBtnLabelForeground }" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
