<Page x:Class="UneoWebApplicationAutoInstaller.Views.ProcessSelection"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UneoWebApplicationAutoInstaller.Views"
      xmlns:vm="clr-namespace:UneoWebApplicationAutoInstaller.ViewModels" d:DataContext="{d:DesignInstance Type=vm:ProcessSelectionViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProcessSelection">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!--Process Selection Radio Button-->
        <Grid Grid.Row="0">
            <ItemsControl ItemsSource="{Binding ProcessSelection}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="ProcessSelection" Cursor="Hand" MouseLeftButtonDown="SelectProcess_Clicked">
                            <Border BorderBrush="{Binding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,5,0,5" Background="#FFFDF9">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton GroupName="Options" IsChecked="{Binding IsChecked}" VerticalAlignment="Top" Margin="5"/>
                                    <StackPanel Orientation="Vertical" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding ProcessName}" FontWeight="Heavy" FontSize="16" Foreground="{Binding ProcessNameForeground}"/>
                                        <TextBlock Text="{Binding ProcessDescription}" TextWrapping="Wrap" Foreground="Gray" FontSize="12" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!--Control Button-->
        <Grid Grid.Row="1">
            <Border HorizontalAlignment="Right" Width="100" Height="40" CornerRadius="8" Background="#0078D3" Cursor="Hand">
                <Grid MouseLeftButtonUp="ProceedToNextStage_Clicked">
                    <Label FontSize="18" Content="Next" Foreground="White" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
                
                
    </Grid>
</Page>
