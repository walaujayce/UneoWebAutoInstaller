<Page x:Class="UneoWebApplicationAutoInstaller.Views.ProgressMonitor"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UneoWebApplicationAutoInstaller.Views"
      xmlns:vm="clr-namespace:UneoWebApplicationAutoInstaller.ViewModels" d:DataContext="{d:DesignInstance Type=vm:ProgressMonitorViewModel}"
      xmlns:behaviors="clr-namespace:UneoWebApplicationAutoInstaller.Utilities"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProgressMonitor">

    <Page.Resources>
        <Style x:Key="ProgressImageStyle" TargetType="Image">
            <Style.Triggers>
                <!-- Fail -->
                <DataTrigger Binding="{Binding StatusState}" Value="0">
                    <Setter Property="Source" Value="/Views/Assets/Icon_Fail_FFFF0000.png"/>
                </DataTrigger>
                <!-- Success -->
                <DataTrigger Binding="{Binding StatusState}" Value="1">
                    <Setter Property="Source" Value="/Views/Assets/Icon_Pass_FF7CFC00.png"/>
                </DataTrigger>
                <!-- Ongoing -->
                <DataTrigger Binding="{Binding StatusState}" Value="2">
                    <Setter Property="Source" Value="/Views/Assets/Icon_Loading.png"/>
                </DataTrigger>
                <!-- Warning -->
                <DataTrigger Binding="{Binding StatusState}" Value="4">
                    <Setter Property="Source" Value="/Views/Assets/Icon_Warning_FFFCD700.png"/>
                </DataTrigger>
                <!-- Pending -->
                <DataTrigger Binding="{Binding StatusState}" Value="3">
                    <Setter Property="Source" Value="{x:Null}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ProgressDescriptionImageStyle" TargetType="Image">
            <Style.Triggers>
                <!-- Fail -->
                <DataTrigger Binding="{Binding StatusStatePD}" Value="0">
                    <Setter Property="Source" Value="/Views/Assets/Icon_Fail_FFFF0000.png"/>
                </DataTrigger>
                <!-- Success -->
                <DataTrigger Binding="{Binding StatusStatePD}" Value="1">
                    <Setter Property="Source" Value="/Views/Assets/Icon_Pass_FF7CFC00.png"/>
                </DataTrigger>
                <!-- Ongoing -->
                <DataTrigger Binding="{Binding StatusStatePD}" Value="2">
                    <Setter Property="Source" Value="/Views/Assets/Icon_Loading.png"/>
                </DataTrigger>
                <!-- Warning -->
                <DataTrigger Binding="{Binding StatusStatePD}" Value="4">
                    <Setter Property="Source" Value="/Views/Assets/Icon_Warning_FFFCD700.png"/>
                </DataTrigger>
                <!-- Pending -->
                <DataTrigger Binding="{Binding StatusStatePD}" Value="3">
                    <Setter Property="Source" Value="{x:Null}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Expand Border Image -->
        <Style x:Key="Expand_Border_Image" TargetType="Border">
            <Setter Property="Padding" Value="3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="17.5"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="Transparent"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation
                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                To="#f2f2f2"
                                Duration="0:0:0.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation
                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                To="Transparent"
                                Duration="0:0:0.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Expand Button Image -->
        <Style x:Key="Expand_Button_Image" TargetType="Border">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="3"/>            
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!--Label-->
        <Grid Grid.Row="0">
            <Label Content="Installation progress:" VerticalContentAlignment="Center" FontSize="14" Padding="0" Margin="0,5" FontFamily="Tahoma" FontWeight="Bold"/>
        </Grid>
        <!--Progress Messages List-->
        <Grid Grid.Row="1" Margin="0,5">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ProgressList}" Padding="0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">
                                <Border Cursor="Hand" MouseLeftButtonUp="ExpandDetail_Clicked" Style="{DynamicResource Expand_Border_Image}">
                                    <Grid Height="35" Margin="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{DynamicResource Expand_Button_Image}">
                                            <Image Source="{Binding ExpandImage}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding ProgressName}" FontSize="14" FontFamily="Times New Roman" VerticalAlignment="Center" Opacity="{Binding ProgressNameTextOpacity}" Padding="0,0,0,0"/>
                                        <Border Padding="5" Grid.Column="2">
                                            <Image x:Name="LoadingIconTitle" Style="{DynamicResource ProgressImageStyle}" RenderTransformOrigin="0.5,0.5" behaviors:ImageBehaviors.IsRotating="{Binding IsRotating}">
                                                <Image.RenderTransform>
                                                    <RotateTransform x:Name="LoadingRotateTransformTitle" Angle="0"/>
                                                </Image.RenderTransform>
                                            </Image>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border Height="Auto" BorderBrush="Black" BorderThickness="0.2" CornerRadius="5" Margin="5" Padding="2" Visibility="{Binding IsDetailedListVisible}">
                                    <ItemsControl ItemsSource="{Binding ProgressDescriptionList}" Padding="10,0,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="35" Margin="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding ProgressDescription}" FontSize="12" FontFamily="Times New Roman" VerticalAlignment="Center" Opacity="{Binding ProgressDescriptionTextOpacity}"/>
                                                    <Border Padding="5" Grid.Column="1">
                                                        <Image x:Name="LoadingIconSubtitle" Style="{DynamicResource ProgressDescriptionImageStyle}" RenderTransformOrigin="0.5,0.5" behaviors:ImageBehaviors.IsRotating="{Binding IsRotating}">
                                                            <Image.RenderTransform>
                                                                <RotateTransform x:Name="LoadingRotateTransformSubtitle" Angle="0"/>
                                                            </Image.RenderTransform>
                                                        </Image>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        <!--Control Button-->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Border  Width="100" Height="40" CornerRadius="8" Background="LightGray" Cursor="Hand" MouseLeftButtonUp="BackToPrevious_ProgressMonitor_Clicked">
                    <Label FontSize="18" Content="Back" Foreground="Gray" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                </Border>
            </Grid>
            <Grid Grid.Column="2">
                <Border  Width="100" Height="40" CornerRadius="8" Background="#0078D3" Cursor="Hand" MouseLeftButtonUp="ProceedToNextStage_ProgressMonitor_Clicked">
                    <Label FontSize="18" Content="Next" Foreground="White" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
