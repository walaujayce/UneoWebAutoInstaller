<Page x:Class="UneoWebApplicationAutoInstaller.Views.ProgressMonitor"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UneoWebApplicationAutoInstaller.Views"
      xmlns:vm="clr-namespace:UneoWebApplicationAutoInstaller.ViewModels" d:DataContext="{d:DesignInstance Type=vm:ProgressMonitorViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProgressMonitor">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!--Label-->
        <Grid Grid.Row="0">
            <Label Content="Installation Detail:" FontSize="14" Padding="0" Margin="0,5"/>            
        </Grid>
        <!--Progress Messages List-->
        <Grid Grid.Row="1" Margin="0,5">
            <Border BorderBrush="Black" BorderThickness="0.2" CornerRadius="5">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ProgressList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Label Content="{Binding ProgressName}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>                
            </Border>
        </Grid>
        <!--Control Button-->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Border  Width="100" Height="40" CornerRadius="8" Background="LightGray" Cursor="Hand" MouseLeftButtonUp="BackToPrevious_ProgressMonitor_Clicked">
                    <Label FontSize="18" Content="Back" Foreground="Gray" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                </Border>
            </Grid>
            <Grid Grid.Column="2">
                <Border  Width="100" Height="40" CornerRadius="8" Background="#0078D3" Cursor="Hand" MouseLeftButtonUp="ProceedToNextStage_ProgressMonitor_Clicked">
                    <Label FontSize="18" Content="Next" Foreground="White" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
