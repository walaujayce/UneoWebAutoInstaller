<Window x:Class="UneoWebApplicationAutoInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UneoWebApplicationAutoInstaller"
        xmlns:vm="clr-namespace:UneoWebApplicationAutoInstaller.ViewModels" d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        mc:Ignorable="d"
        Title="{Binding MainWindowTitle}" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        >

    <Window.Resources>
        <Style x:Key="Border_Image_CloseBtn" TargetType="Border">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="0,0"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="17.5"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="Transparent"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation
                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                        To="#ff4747"
                        Duration="0:0:0.5"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation
                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                        To="Transparent"
                        Duration="0:0:0.5"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Background="Transparent">
        <Border CornerRadius="10" BorderBrush="Black" BorderThickness="1" Background="White"/>
        <Grid Margin="15,15,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!--Title Bar-->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Label Content="{Binding MainWindowTitle}" Foreground="Orange" FontFamily="roboto" FontSize="18" FontWeight="ExtraBold" VerticalAlignment="Center" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Padding="0"/>
                </Grid>
                <Grid Grid.Column="1">
                    <Border Style="{DynamicResource Border_Image_CloseBtn}" MouseLeftButtonUp="CloseWindow_Clicked" Cursor="Hand">
                        <Image Source="/Views/Assets/Icon_Close.png"/>
                    </Border>
                </Grid>
            </Grid>
            <!--Main Content-->
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Border BorderBrush="Transparent" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Frame x:Name="Navigation"
                       NavigationUIVisibility="Hidden"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch" />
                    </Grid>
                </Border>
            </Grid>
            <!--Footer-->
            <Grid Grid.Row="2" Margin="5">
                <Label Padding="0" FontSize="12" Content="Copyright" Foreground="Black" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
            </Grid>
        </Grid>
        <Border x:Name="Overlay" Visibility="{Binding OverlayVisibility}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Background="Black" Opacity="0.3" Panel.ZIndex="99"/>
    </Grid>
</Window>
