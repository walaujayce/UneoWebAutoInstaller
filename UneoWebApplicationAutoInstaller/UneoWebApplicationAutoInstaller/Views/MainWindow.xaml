<Window x:Class="UneoWebApplicationAutoInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UneoWebApplicationAutoInstaller"
        xmlns:vm="clr-namespace:UneoWebApplicationAutoInstaller.ViewModels" d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        mc:Ignorable="d"
        Title="{Binding MainWindowTitle}" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        >

    <Window.Resources>
        <Style x:Key="Border_Image_CloseBtn" TargetType="Border">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="0,0"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="17.5"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="Transparent"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation
                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                        To="#ff4747"
                        Duration="0:0:0.5"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation
                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                        To="Transparent"
                        Duration="0:0:0.5"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Background="Transparent">
        <Border CornerRadius="10" BorderBrush="Black" BorderThickness="0.5" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!--Title Bar-->
                <Border Grid.Row="0" MouseLeftButtonDown="DragWindow_Click" Background="Transparent" Padding="15,15,15,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Label Content="{Binding MainWindowTitle}" Foreground="Orange" FontFamily="roboto" FontSize="18" FontWeight="ExtraBold" VerticalAlignment="Center" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Padding="0"/>
                        </Grid>
                        <Grid Grid.Column="1">
                            <Border Style="{DynamicResource Border_Image_CloseBtn}" MouseLeftButtonUp="CloseWindow_Clicked" Cursor="Hand" MouseLeftButtonDown="AvoidDragWindow_Clicked">
                                <Image Source="/Views/Assets/Icon_Close_FFD3D3D3.png"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
                <!--Main Content-->
                <Grid Grid.Row="1" Margin="0,10,0,10" Background="Transparent">
                    <Border BorderBrush="Transparent" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Frame x:Name="Navigation"
                       NavigationUIVisibility="Hidden"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch" />
                        </Grid>
                    </Border>
                </Grid>
                <!--Footer-->
                <Border Grid.Row="2" Padding="10,5" Height="30" CornerRadius="0,0,10,10" Background="#F9F9FA">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="6*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="1" Padding="0" FontSize="12" Content="Copyright" FontFamily="Arial" FontStyle="Italic" Foreground="Gray" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Image Source="/Views/Assets/Icon_Info_B0470F.png" Margin="5,0" Height="15"/>
                            <TextBlock x:Name="Version" Text="New version available" Foreground="#B0470F" VerticalAlignment="Center" FontFamily="Arial" FontWeight="Bold" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <Border x:Name="Overlay" Visibility="{Binding OverlayVisibility}" BorderBrush="Black" BorderThickness="1" CornerRadius="10" Background="Black" Opacity="0.3" Panel.ZIndex="99"/>
    </Grid>
</Window>
